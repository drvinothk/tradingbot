# Secrets and credentials — never commit
backend/app/config/credentials/*
!backend/app/config/credentials/.gitkeep
!backend/app/config/credentials/*.example
*.env
!*.env.example

# Vendor-supplied docs/Postman exports have shown up here with real bearer
# tokens embedded directly in them (found 2026-08-11, TrueData's own
# Postman collections) — never let a folder like this become committable
# even briefly, regardless of what it's named or when it gets deleted.
Delete later/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
frontend/build/

# Alembic (keep migrations, ignore local sqlite if ever used for scratch)
*.sqlite3

# Windows / IDE
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs
*.log

# DB backups — may contain real trading data
ops/backups/

# Daily trade-log Excel exports (Ops-Hardening Phase 3) — may contain real
# trading data, same reasoning as ops/backups/ above.
backend/reports/

# Backtest tooling outputs — regenerable (downloaded bhavcopy CSVs / a
# generated report), not source; see mock_data_tester.py / query_backtest_
# trades.py on the backup/atr-backtest-session branch.
backend/mock_data/
backend/trade_breakdown.txt

# Fetched TrueData historical data (scripts/fetch_truedata_historical.py) —
# regenerable real market data, not source, same reasoning as mock_data/
# above. Also potentially sizable (per-contract 1-min CSVs).
backend/data/

# Claude
.claude/settings.local.json

# Backtest engine bundle (424M archive + pinned app snapshot; movable to A1)
backtest_engine/
