# Secrets and credentials — never commit
backend/app/config/credentials/*
!backend/app/config/credentials/.gitkeep
!backend/app/config/credentials/*.example
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
frontend/build/

# Alembic (keep migrations, ignore local sqlite if ever used for scratch)
*.sqlite3

# Windows / IDE
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs
*.log

# DB backups — may contain real trading data
ops/backups/

# Claude
.claude/settings.local.json
