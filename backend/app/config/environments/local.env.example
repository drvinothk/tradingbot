# Copy to backend/.env for local development. Never commit the real .env.

APP_ENV=local
APP_SECRET_KEY=change-me-to-a-random-value
APP_SESSION_TTL_MINUTES=720

DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trading_bot
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

RISK_MAX_CONCURRENT_POSITIONS=2
RISK_MAX_TRADES_PER_DAY=15
RISK_CONSECUTIVE_LOSS_PAUSE_THRESHOLD=2
RISK_DAILY_LOSS_CAP=5000
RISK_DAILY_TARGET_PROFIT=5000
RISK_PER_TRADE_LOT_CAP=1
RISK_DEFAULT_BUDGET=50000
