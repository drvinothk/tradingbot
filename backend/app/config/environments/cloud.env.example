# Stage 2/3 template. Real values come from the secret manager at that stage,
# not from a file on disk — this is a reference for which keys must be provided.

APP_ENV=cloud
APP_SECRET_KEY=__from_secret_manager__
APP_SESSION_TTL_MINUTES=720

DB_HOST=__managed_db_host__
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=__from_secret_manager__
DB_PASSWORD=__from_secret_manager__

REDIS_HOST=__managed_redis_host__
REDIS_PORT=6379
REDIS_DB=0

RISK_MAX_CONCURRENT_POSITIONS=2
RISK_MAX_TRADES_PER_DAY=5
RISK_CONSECUTIVE_LOSS_PAUSE_THRESHOLD=2
RISK_DAILY_LOSS_CAP=5000
RISK_DAILY_TARGET_PROFIT=5000
RISK_PER_TRADE_LOT_CAP=1
RISK_DEFAULT_BUDGET=50000
