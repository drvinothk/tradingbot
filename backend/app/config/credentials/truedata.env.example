# Copy to backend/app/config/credentials/truedata.env and fill in real values.
# This file (and truedata.env itself) is gitignored — never commit real secrets here.
#
# USERNAME / PASSWORD are the login credentials TrueData issued for API access
# (not necessarily the same as any web-portal login) — from your TrueData
# account manager / the credentials email, once received.
#
# URL: leave as push.truedata.in (the real production feed) for normal use.
# Set to replay.truedata.in ONLY for an intentional aftermarket test session —
# it streams a prior real trading day back as though it were live right now.
# Confirmed real via truedata-ws's own official PyPI README (not guessed).
# Never leave this pointed at replay before a real trading day starts.
#
# LIVE_PORT: 8084 is TrueData's own official spec's Production real-time
# WebSocket port (corrected 2026-08-11 — the prior 8082 default came from
# truedata-ws's own README, not TrueData's own documentation, and doesn't
# match either of that spec's two documented ports). Use 8086 instead for
# the Sandbox environment while testing/integrating, per that same spec.

TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
TRUEDATA_URL=push.truedata.in
TRUEDATA_LIVE_PORT=8084
