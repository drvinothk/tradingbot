# Copy to backend/app/config/credentials/shoonya.env and fill in real values.
# This file (and shoonya.env itself) is gitignored — never commit real secrets here.
#
# CLIENT_ID and SECRET_CODE come from trade.shoonya.com -> profile -> API key.
# REDIRECT_URL is the value to register on Shoonya's API key form — it's used
# for real (OAuth-style browser redirect), not just a registration formality;
# http://127.0.0.1:5000/... is fine since the redirect happens in your own
# browser on this machine, not a server-to-server call.

SHOONYA_CLIENT_ID=
SHOONYA_SECRET_CODE=
SHOONYA_USER_ID=
SHOONYA_REDIRECT_URL=http://127.0.0.1:5000/shoonya/callback
SHOONYA_API_HOST=https://api.shoonya.com/NorenWClientAPI
SHOONYA_WS_HOST=wss://api.shoonya.com/NorenWSAPI/
# WS auth handshake has never once succeeded live (returns NOT_OK every time,
# see ws_client.py's docstring). "API" is the default (classic-QuickAuth
# convention) but was never itself varied against a real OAuth-issued token —
# try "WEB" or "MOB" here if API keeps failing.
SHOONYA_WS_AUTH_SOURCE=API
