# Copy to backend/app/config/credentials/alice_blue.env and fill in real values.
# This file (and alice_blue.env itself) is gitignored — never commit real secrets here.
#
# APP_CODE / API_SECRET come from Alice Blue's ANT developer portal
# (a3.aliceblueonline.com -> My Apps -> Create New App). Alice Blue's own docs
# call these "App Code" (appCode) and "API Secret" (apiSecret).
# REDIRECT_URL must match exactly what's registered for this App Code in the
# portal — Alice Blue redirects the user's browser here after login, with
# authCode/userId query params.
#
# Market-data only (see AliceBlueSettings' own docstring) — no order/account
# fields exist here by design, same boundary AliceBlueMarketDataProvider's
# own interface enforces structurally.
ALICEBLUE_APP_CODE=
ALICEBLUE_API_SECRET=
ALICEBLUE_REDIRECT_URL=https://68-233-110-76.sslip.io/aliceblue/callback

# Leave blank for a direct connection — no IP block confirmed on Alice
# Blue's side yet (unlike Angel One). Set to an HTTP(S) proxy URL you
# personally control if a future login/history call is rejected the same
# way apiconnect.angelone.in was.
ALICEBLUE_AUTH_PROXY=
