# Copy to backend/app/config/credentials/angel_one.env and fill in real values.
# This file (and angel_one.env itself) is gitignored — never commit real secrets here.
#
# API_KEY / CLIENT_CODE come from smartapi.angelone.in (Angel One's developer portal).
# PASSWORD is the account login PIN/password used with loginByPassword.
# TOTP_SECRET is the base32 secret behind your authenticator app (NOT a live
# 6-digit code) — this backend generates the live code itself via pyotp at
# login time, since Angel's loginByPassword needs a real TOTP in the request
# body (unlike Shoonya, whose TOTP entry happens in your own browser).
# MAC_ADDRESS: leave blank to auto-detect via uuid.getnode(); set explicitly
# only if login rejects with a MAC-related error live.
# AUTH_PROXY: leave blank for a direct connection. Live-confirmed 2026-08-05:
# apiconnect.angelone.in times out from the OCI VM's own IP while responding
# instantly to the identical request from an unrelated residential IP —
# set this to an HTTP(S) proxy URL you personally control
# (http://host:port or https://user:pass@host:port) to route the REST calls
# (login + candle history — not the WebSocket) through a different egress IP.
# Never point this at a public/third-party proxy — whoever runs it can see
# the plaintext login payload (API key, client code, password, TOTP code).

ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
ANGELONE_MAC_ADDRESS=
ANGELONE_AUTH_PROXY=
ANGELONE_REST_HOST=https://apiconnect.angelone.in
ANGELONE_WS_HOST=wss://smartapisocket.angelone.in/smart-stream
ANGELONE_SCRIP_MASTER_URL=https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json
ANGELONE_SCRIP_MASTER_URL_FALLBACK=https://margincalculator.angelbroking.com/OpenAPI_MasterData/OpenAPIScripMaster.json
