# Copy to backend/app/config/credentials/telegram.env and fill in real values.
# This file (and telegram.env itself) is gitignored — never commit real secrets here.
#
# BOT_TOKEN: from @BotFather on Telegram (create a bot, copy the token it gives you).
# CHAT_ID: the numeric chat/user ID Telegram alerts should be sent to — message
# your bot once, then hit https://api.telegram.org/bot<token>/getUpdates to find it.
#
# Both fields default to empty if this file doesn't exist or isn't filled in —
# app.modules.alerting.manager treats that as "Telegram not configured" and
# falls back to SystemAlert-only, not an error. Nothing else in this system
# depends on Telegram being set up.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
